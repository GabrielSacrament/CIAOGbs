# ==========================================
# CIAOGbs - .env.example
# ==========================================
#
# COMO USAR (fase futura, quando houver consumo real de config):
#   1. Copie este arquivo para ".env":
#        Copy-Item .env.example .env
#   2. Preencha os valores em .env
#   3. Nunca versione o .env (ele ja esta no .gitignore)
#
# REGRA ABSOLUTA:
#   NENHUM segredo real (chave de API, token, senha) entra neste arquivo.
#   Este arquivo e um MODELO e deve permanecer apenas com nomes de variaveis
#   e valores vazios. Se um valor real for necessario, ele vai no .env local,
#   que nunca e commitado.
#
# Estado atual: FASE 1 (primeiro corte vertical com FFmpeg) concluida.
# O codigo desta fase NAO le este arquivo: nao ha configuracao externa ainda.
# Os valores abaixo sao placeholders para fases futuras.


# ---------- FASE 1 - Processamento de video com FFmpeg ----------

# PREVISTO PARA FASE FUTURA. Hoje o codigo chama "ffmpeg" pelo nome e
# depende do PATH do sistema. Esta variavel nao e lida.
# Caminho do executavel do FFmpeg.
# Windows (instalacao atual): C:\ffmpeg-9.0.2-essentials_build\bin\ffmpeg.exe
FFMPEG_PATH=

# PREVISTO PARA FASE FUTURA. Hoje a saida e fixa em 1080x1920 dentro de
# src/cut_video.py (OUTPUT_WIDTH / OUTPUT_HEIGHT). Estas variaveis nao sao lidas.
# Resolucao de trabalho antes da conversao para 9:16 (Reels / TikTok).
TARGET_WIDTH=1080
TARGET_HEIGHT=1920

# PREVISTO PARA FASE FUTURA. Hoje o FPS do video final e o mesmo da origem,
# porque o comando nao usa -r. Esta variavel nao e lida.
TARGET_FPS=30


# ---------- FASES FUTURAS - Transcricao e IA ----------
# Apenas reservar os nomes agora. Nao instalar bibliotecas ainda.

# Modelo de transcricao (Fase de transcricao).
WHISPER_MODEL=

# Idioma esperado do audio, usado como hint na transcricao.
SOURCE_LANGUAGE=pt


# ---------- FASES FUTURAS - APIs externas ----------
# Nenhuma API e chamada hoje. Preencha no .env local quando a fase chegar.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
